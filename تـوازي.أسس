اشمل "Threading.alusus"؛

عرف تـوازي: لقب Threading؛
@دمج وحدة تـوازي {
    عرف مـسلك: لقب Thread؛

    عرف مـزايا_مسلك: لقب ThreadAttributes؛
    @دمج صنف مـزايا_مسلك {
        عرف أعلام: لقب flags؛
        عرف حجم_المكدس: لقب stackSize؛
        عرف مجال_التنافس: لقب contentionScope؛
        عرف توريث_الجدولة: لقب inheritSched؛
        عرف فصل_الحالة: لقب detachState؛
        عرف جدولة: لقب sched؛
        عرف معلمة: لقب param؛
        عرف وقت_البداية: لقب startTime؛
        عرف حد_اقصى: لقب deadLine؛
        عرف فترة: لقب period؛
    }

    عرف مـعامل_جدولة: لقب SchedParam؛
    @دمج صنف مـعامل_جدولة {
        عرف أولوية_الجدولة: لقب schedPriority؛
    }؛

    عرف تـفصيل_زمني: لقب TimeSpec؛
    @دمج صنف تـفصيل_زمني {
        عرف مدة_ثواني: لقب tvSec؛
        عرف مدة_نانو: لقب tvNsec؛
    }؛

    عرف مـزامن: لقب Mutex؛
     @دمج صنف مـزامن {
        عرف بيانات: لقب data؛
        عرف هيئ: لقب init؛
        عرف اقفل: لقب lock؛
        عرف افتح: لقب unlock؛
    }

    عرف مـزايا_مزامن: لقب MutexAttributes؛

    عرف شـرط : لقب Cond؛
    @دمج صنف شـرط {
        عرف بيانات: لقب data؛
    }

    عرف مـزايا_شرط: لقب CondAttributes؛

    عرف مـحلي_لمسلك: لقب ThreadLocal؛
    @دمج صنف مـحلي_لمسلك {
        عرف مهيئ: لقب initializer؛
        عرف القيمة: لقب value؛
    }

    عرف أنشئ_مسلكا: لقب createThread؛
    عرف التق_بمسلك: لقب joinThread؛
    عرف هيئ_مزامنا: لقب  initMutex؛
    عرف اقفل_مزامنا: لقب lockMutex؛
    عرف حاول_قفل_مزامن: لقب tryLockMutex؛
    عرف افتح_مزامنا: لقب unlockMutex؛
    عرف هيئ_شرطا: لقب initCond؛
    عرف علم_شرطا: لقب signalCond؛
    عرف انتظر_شرطا: لقب waitCond؛
}

